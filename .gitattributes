# Keep shell/batch scripts in the line ending their interpreter expects, so a
# checkout behaves the same on Windows and Linux and script files do not show
# up as conflicted over whitespace alone.
gradlew   text eol=lf
*.sh      text eol=lf
*.bat     text eol=crlf
*.cmd     text eol=crlf

# Binary assets: never diff, merge or convert these.
*.jar     binary
*.png     binary
*.ttf     binary
*.gif     binary
*.jpg     binary
